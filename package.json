{
  "name": "medical-distribution-system",
  "version": "1.0.0",
  "private": true,
  "description": "Medical Distribution System — Production Deployment",
  "scripts": {
    "install:backend": "npm ci --omit=dev --prefix backend",
    "install:frontend": "npm install --omit=dev --prefix frontend",
    "install:all": "npm ci --omit=dev --prefix backend && npm install --omit=dev --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm start --prefix frontend",
    "build": "npm run install:all",
    "build:hostinger": "npm run install:all && npm run build",
    "start": "node start.mjs",
    "db:setup": "npm run db:setup --prefix backend",
    "reset-admin": "npm run reset-admin --prefix backend"
  }
}
